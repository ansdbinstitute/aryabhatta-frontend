# ANSDB Project Configuration

# Strapi backend URL (for production - app.ansdb.org)
# Use http://localhost:1337 for development
VITE_STRAPI_URL=https://app.ansdb.org

# Application Type Override (for local development)
# Options: main, student, erp
# Use ?app=erp or ?app=student in URL as alternative
# VITE_APP_TYPE=erp

# Application Metadata
VITE_APP_NAME="Aryabhatta National Skill Development Board"
VITE_APP_SHORT_NAME="ANSDB"

# Feature Flags
VITE_ENABLE_MAINTENANCE_MODE=false
