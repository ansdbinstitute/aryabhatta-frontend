# ANSDB Project Configuration Environment Variables

# Strapi Backend URL (empty = use Vite proxy in development)
# For production, uncomment and set your domain:
# VITE_STRAPI_URL=https://api.your-domain.com

# Application Metadata
VITE_APP_NAME="Aryabhatta National Skill Development Board"
VITE_APP_SHORT_NAME="ANSDB"

# Feature Flags
VITE_ENABLE_MAINTENANCE_MODE=false
